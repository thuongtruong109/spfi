{
  "name": "spf",
  "type": "module",
  "private": true,
  "version": "2.1.0",
  "description": "Telescope the Shopify storefront in pipeline from one desk",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:node && npm run test:unit",
    "test:node": "node --test tests/*.test.ts",
    "test:unit": "vitest run",
    "typecheck": "nuxi typecheck",
    "postinstall": "nuxt prepare",
    "tauri": "tauri"
  },
  "dependencies": {
    "@lucide/vue": "^1.28.0",
    "@tauri-apps/api": "^2.11.1",
    "axios": "^1.15.2",
    "googleapis": "^171.4.0",
    "https-proxy-agent": "^9.0.0",
    "ioredis": "^5.10.1",
    "node-fetch": "^2.7.0",
    "nuxt": "^4.4.2",
    "papaparse": "^5.5.3",
    "pinia": "^3.0.4",
    "socks-proxy-agent": "^10.0.0",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@pinia/nuxt": "^0.11.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^25.7.0",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.11.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  }
}
