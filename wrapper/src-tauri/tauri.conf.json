{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "spfi",
  "version": "2.1.0",
  "identifier": "spfi.thuongtruong.me",
  "build": {
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Telescope the Shopify storefront in pipeline from one desk",
    "longDescription": "A compact workspace for connecting shops, rotating tokens, checking public store status, and reading data without jumping between tools.",
    "icon": [
      "./icons/32x32.png",
      "./icons/128x128.png",
      "./icons/128x128@2x.png",
      "./icons/icon.icns",
      "./icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
