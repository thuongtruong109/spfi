# Comma-separated cross-origin browser clients. Same-host requests are allowed
# automatically, so leave this empty unless a separate trusted UI is required.
NUXT_ALLOWED_ORIGINS=

# Unsafe browser API methods require Origin or same-origin Fetch Metadata.
# Keep Host-header fallback disabled outside compatibility-only local setups.
NUXT_API_ORIGIN_REQUIRED=true
NUXT_ALLOW_HOST_ORIGIN_FALLBACK=false

# Shopify releases stable Admin API versions quarterly. Rotate this value
# after validating the app against a newer version.
NUXT_ADMIN_API_VERSION=2026-07

# Optional per-IP limits.
NUXT_API_RATE_LIMIT_PER_MINUTE=1200
# Analytics and export requests also consume these stricter, route-specific
# buckets in addition to the app-wide API bucket.
NUXT_ANALYTICS_RATE_LIMIT_PER_MINUTE=120
NUXT_EXPORT_RATE_LIMIT_PER_MINUTE=20
# Shopify does not publish a numeric OAuth token-endpoint limit. Set a positive
# value only when this deployment needs an additional local token quota.
NUXT_TOKEN_RATE_LIMIT_PER_MINUTE=40

# Enable only when the app is reachable exclusively through a trusted reverse
# proxy that overwrites X-Forwarded-For (the bundled nginx config does).
NUXT_TRUST_PROXY_HEADERS=false

# Private/VPN SOCKS endpoints are denied by default. This opt-out weakens SSRF
# protection and should only be used on a deliberately isolated deployment.
NUXT_ALLOW_PRIVATE_PROXY_HOSTS=false

# Keep the diagnostic proxy endpoint disabled outside local development.
NUXT_DEBUG_PROXY_ENABLED=false
NUXT_DEBUG_PROXY_ALLOWED_HOSTS=httpbin.org,api.ipify.org

# Public HTTPS origin Shopify can reach. When omitted, the browser request
# origin is used. Set this explicitly behind tunnels or multi-proxy deployments.
NUXT_WEBHOOK_PUBLIC_URL=

# Encrypts per-shop webhook signing secrets at rest. Keep stable across
# restarts; without it, secrets remain process-memory only and reconnecting the
# browser rehydrates them.
NUXT_WEBHOOK_ENCRYPTION_KEY=

# Persistent webhook notification and delivery-deduplication storage.
NITRO_WEBHOOK_STORAGE_PATH=.data/webhooks

# Optional shared storage for horizontal scaling. When set, it replaces the
# local filesystem webhook storage and lets all replicas see deliveries/SSE events.
NITRO_WEBHOOK_REDIS_URL=
NITRO_WEBHOOK_REDIS_PREFIX=spf:webhooks

# Optional browser-visible Google Sheet defaults. Lists accept comma-separated
# values or a JSON string array when a tab name itself contains a comma.
NUXT_PUBLIC_SHEET_URLS=
NUXT_PUBLIC_MASTER_SHEET_URL=
NUXT_PUBLIC_MASTER_SHEET_TABS=

# Docker Compose maps this value into the app container.
SPFI_ALLOWED_ORIGINS=

# The bundled nginx listener is intentionally plain HTTP and loopback-only.
# Keep this default unless a trusted TLS reverse proxy reaches another bind address.
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_PORT=80
